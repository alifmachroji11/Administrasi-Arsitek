# Auth (required)
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth (optional — login/register screens hide the Google button
# if unset). Setup: console.cloud.google.com -> a project -> APIs &
# Services -> OAuth consent screen (External is fine for testing) -> then
# Credentials -> Create Credentials -> OAuth client ID -> type "Web
# application". Add an Authorized redirect URI for every place this app
# runs, exactly:
#   http://localhost:3000/api/auth/callback/google        (local dev)
#   https://<your-vercel-domain>/api/auth/callback/google  (production)
# Copy the generated Client ID / Client secret below (and into Vercel's
# Project Settings -> Environment Variables for production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (optional — omit to run on the in-memory mock repository)
# Postgres connection string, e.g. from a Supabase project.
DATABASE_URL=

# WhatsApp Cloud API (optional — omit to run on the mock WhatsApp client,
# which logs sends to the console and echoes OTP codes back to the UI for
# testing without a real WABA). See Bagian 5 of the product brief for the
# Meta Business verification steps required before these are usable.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=notula_otp
NEXT_PUBLIC_WHATSAPP_BOT_DISPLAY_NUMBER="+62 812-3456-7890"

# AI (optional — omit to run on heuristic mocks for classification,
# report summaries, and search synthesis). Verify the current model ID
# against Anthropic's docs — deliberately not hardcoded here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
